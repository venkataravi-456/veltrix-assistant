# Veltrix PeopleOps Assistant Environment Variables
# Defaults point to ./data as specified in Section 10.2

CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
APP_TODAY=2026-09-15

# LLM Provider options: gemini, openai, anthropic
LLM_PROVIDER=gemini

# Provider API Keys (leave blank in example, provide in .env)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
